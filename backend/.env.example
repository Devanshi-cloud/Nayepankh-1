# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWKS_URL=your_supabase_jwks_url

# Razorpay LIVE Configuration
RAZORPAY_LIVE_KEY_ID=your_razorpay_live_key_id
RAZORPAY_LIVE_KEY_SECRET=your_razorpay_live_key_secret

# Razorpay LIVE Subscription Plan ID (create in Razorpay Dashboard)
RAZORPAY_PLAN_ID=your_razorpay_live_plan_id

# Gmail SMTP Configuration for OTP
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_app_password

# JWT Secret for Custom Authentication
JWT_SECRET=replace_with_a_long_random_secret
