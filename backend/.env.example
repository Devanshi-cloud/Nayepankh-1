[TEMPLATE]
# ─────────────────────────────────────────────────────────────
# BACKEND ENVIRONMENT VARIABLES (server-side only — NEVER expose to frontend)
# Add these to your Vercel backend project's Environment Variables.
# ─────────────────────────────────────────────────────────────

# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_SECRET_KEY=your_supabase_secret_key  # Fallback if service role key not set

# Razorpay LIVE Configuration
RAZORPAY_LIVE_KEY_ID=your_razorpay_live_key_id
RAZORPAY_LIVE_KEY_SECRET=your_razorpay_live_key_secret
# Fallback plan ID (only used if frontend doesn't send planId in request)
# Note: Use 'plan_' prefix IDs from Razorpay Dashboard (19 chars), not 'sub_' IDs
RAZORPAY_PLAN_ID=plan_xxxxx

# Gmail SMTP Configuration for OTP
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_app_password

# JWT Secret for Custom Authentication
JWT_SECRET=replace_with_a_long_random_secret

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
