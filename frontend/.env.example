[TEMPLATE]
# ─────────────────────────────────────────────────────────────
# FRONTEND ENVIRONMENT VARIABLES (safe to expose in browser)
# Only VITE_ prefixed vars are available in Vite frontend code.
# Add these to your Vercel frontend project's Environment Variables.
# ─────────────────────────────────────────────────────────────

# Supabase (anon key is safe for public clients)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend API endpoint URL (e.g. Vercel backend deployment)
VITE_API_URL=https://your-backend.vercel.app

# Razorpay LIVE Key ID (public, used to open Razorpay checkout)
VITE_RAZORPAY_API_KEY=your_razorpay_live_key_id

# Razorpay LIVE Subscription Plan IDs (create in Razorpay Dashboard)
VITE_RAZORPAY_PLAN_ID_Starter=plan_xxxxx
VITE_RAZORPAY_PLAN_ID_Basic=plan_xxxxx
VITE_RAZORPAY_PLAN_ID_Mini=plan_xxxxx
VITE_RAZORPAY_PLAN_ID_Supporter=plan_xxxxx
VITE_RAZORPAY_PLAN_ID_Champion=plan_xxxxx
VITE_RAZORPAY_PLAN_ID_Guardian=sub_StMN7J8tK68Ng4

# Sanity CMS
VITE_SANITY_PROJECT_ID=07wnn0p1
VITE_SANITY_DATASET=production


# ─────────────────────────────────────────────────────────────
# 🚫 DO NOT ADD THESE AS VITE_ ENV VARS (backend-only secrets)
#    They would be bundled into the frontend JS and exposed!
# ─────────────────────────────────────────────────────────────
# ❌ VITE_SUPABASE_SECRET_KEY
# ❌ VITE_SUPABASE_SERVICE_ROLE_KEY
# ❌ VITE_SUPABASE_PUBLISHABLE_KEY
# ❌ VITE_SUPABASE_JWKS_URL
# ❌ VITE_RAZORPAY_LIVE_KEY_SECRET
# ❌ VITE_GMAIL_USER / VITE_GMAIL_PASS
# ❌ VITE_JWT_SECRET
