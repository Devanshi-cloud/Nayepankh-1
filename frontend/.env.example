# Supabase Public Keys (Vite needs VITE_ prefix)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend API endpoint URL
VITE_API_URL=https://your-backend.vercel.app

# Razorpay LIVE Key ID (used to initialize Razorpay checkout on frontend)
VITE_RAZORPAY_API_KEY=your_razorpay_live_key_id

# Razorpay LIVE Subscription Plan IDs (create in Razorpay Dashboard → Subscriptions → Create Plan)
# VITE_RAZORPAY_PLAN_ID_Starter=plan_xxxxx
# VITE_RAZORPAY_PLAN_ID_Supporter=plan_xxxxx
# VITE_RAZORPAY_PLAN_ID_Champion=plan_xxxxx
# VITE_RAZORPAY_PLAN_ID_Guardian=plan_xxxxx
